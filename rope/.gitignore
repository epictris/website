node_modules
dist
playtests/bundles/
# Production runs pulled by `cli pull`; the store on the server is the source.
playtests/prod/
# Where a local `bun run serve.ts` keeps its store.
.playtests/
# Binary assets - 3D props and authored PBR texture maps - are fetched from a
# GitHub Release at build time, never committed; see "Asset store" in CLAUDE.md.
# `bun run assets:fetch` populates both.
public/meshes/
public/textures/
public/water/
public/hdri/
public/generated-roots/
public/generated-boulders/
public/generated-dirt-moss/
public/generated-vines/
public/generated-mushrooms/
public/generated-grass/
public/generated-plants/
# Raw, un-optimised models as they were downloaded. Local scratch: the shippable
# copy is what `assets:publish` uploads, and a raw is re-downloadable from the
# `source` its manifest entry records.
assets-src/
# Generated rocks (`bun run assets:rocks <level>`), rebuilt from the level file.
public/rocks/
# The generator service's output (boulders, mushroom patches), content-addressed
# by mesh key and regenerated from the level; see docs/generators.md.
public/generated/
# The generators' Python environment (`bun run generators:setup`), and the
# bytecode Blender's own interpreter leaves beside the sources.
.venv/
__pycache__/
