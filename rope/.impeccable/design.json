  "narrative": {
    "northStar": "Midnight Docked Studio",
    "overview": "A docked studio for precise level and sound authoring. Midnight navy furniture frames the real game canvas and recording waveforms; blue identifies controls and selection, while amber singles out clip focus and time.\n\nCompact controls share one system sans size. Hierarchy comes from weight, spacing, alignment and bounded work areas, preserving room for the artifact being edited.",
    "keyCharacteristics": [
      "Midnight tonal panels with restrained borders.",
      "One compact type size with tabular measurements.",
      "Tools and sources left; properties right.",
      "Real canvas and waveforms supply the visual material."
    ],
    "rules": [
      {
        "name": "The Blue Control Rule",
        "body": "Use blue for controls, navigation and general selection; reserve amber for timeline focus, time and status emphasis.",
        "section": "colors"
      },
      {
        "name": "The One Size Rule",
        "body": "Keep authoring text at the shared font size; use weight, spacing and grouping to establish hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Dock Rule",
        "body": "Keep desktop furniture at the workspace edges and let the working artifact occupy the center.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use the shared studio tokens and system sans stack.",
      "Do pair exact numeric values with sliders where both precision and audition matter.",
      "Do provide visible keyboard focus, accessible control names and native keyboard-operable disclosures.",
      "Do preserve distinct Save draft, Export WAV and Apply to game actions.",
      "Do keep mobile editor drawers closed initially and mutually exclusive."
    ],
    "donts": [
      "Don't reintroduce the retired cyan monospace authoring identity.",
      "Don't use amber as the general navigation or button accent.",
      "Don't enlarge headings to create hierarchy within the compact authoring shell.",
      "Don't substitute decorative imagery for real canvas content or waveforms."
    ]
  }
