{
  "name": "rope",
  "version": "0.0.0",
  "type": "module",
  "description": "2D grappling-hook character controller — TS port of the C#/Godot prototype",
  "scripts": {
    "audio:render": "tools/audio/.venv/bin/python tools/audio/audio.py render",
    "audio:sources": "tools/audio/.venv/bin/python tools/audio/audio.py fetch-sources",
    "audio:setup": "python3 -m venv tools/audio/.venv && tools/audio/.venv/bin/python -m pip install -r tools/audio/requirements.txt",
    "audio:analyze": "tools/audio/.venv/bin/python tools/audio/audio.py analyze",
    "audio:reaper": "bash tools/audio/reaper.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/test.ts",
    "replay": "bun run src/tools/cli.ts",
    "dmath:crosscheck": "bun run scripts/dmath-crosscheck.ts",
    "assets:extract": "bun run scripts/extract-mesh.ts",
    "assets:optimize": "bun run scripts/optimize-asset.ts",
    "assets:optimize-texture": "bun run scripts/optimize-texture.ts",
    "assets:optimize-hdri": "bun run scripts/optimize-hdri.ts",
    "assets:publish": "bun run scripts/publish-asset.ts",
    "assets:publish-scenes": "bun run scripts/publish-scenes.ts",
    "assets:publish-models": "bun run scripts/publish-models.ts",
    "assets:publish-sources": "bun run scripts/publish-scene-sources.ts",
    "assets:publish-stored": "bun run scripts/publish-stored.ts",
    "assets:fetch-sources": "bun run scripts/fetch-scene-sources.ts",
    "scene:export": "bun run scripts/scene-export.ts",
    "model:export": "bun run scripts/model-export.ts",
    "formation:build": "bun run scripts/formation-build.ts",
    "formation:sweep": "bun run scripts/formation-sweep.ts",
    "formation:build-level": "bun run scripts/formation-build-level.ts",
    "scene:migrate": "bun run scripts/migrate-scene.ts",
    "assets:publish-formations": "bun run scripts/publish-formations.ts",
    "roots:bake": "bun run scripts/bake-roots.ts",
    "roots:bark": "bun run scripts/bake-root-bark.ts",
    "scene:guide": "bun run scripts/scene-guide.ts",
    "assets:paint": "bun run scripts/paint-textures.ts",
    "assets:fetch": "bun run scripts/fetch-assets.ts",
    "assets:credits": "bun run scripts/credits.ts",
    "generators:setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r tools/blender/requirements.txt",
    "native:build": "python3 tools/blender/native/build.py"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.1",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "meshoptimizer": "1.0.1",
    "three": "^0.185.1"
  }
}
