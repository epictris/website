{
  "kind": "mushrooms",
  "version": 1,
  "provisional": "Written by phase 3 so the generator has a schema to run against; phase 2's schema replaces it at merge. Keys and defaults are the plan's.",
  "groups": ["Placement", "Form", "Look", "Limits"],
  "params": [
    { "key": "seed", "type": "int", "default": 0, "min": 0, "max": 2147483647, "step": 1, "group": "Placement", "basic": true,
      "doc": "Re-rolls placement, sizes and angles." },
    { "key": "density", "type": "number", "unit": "1/m2", "default": 150, "min": 1, "max": 2000, "step": 10, "group": "Placement", "basic": true,
      "doc": "Mushrooms per square metre inside the densest clumps." },
    { "key": "spacing", "type": "number", "unit": "m", "default": 0.02, "min": 0, "max": 1, "step": 0.005, "group": "Placement", "basic": false,
      "doc": "Least distance between stems." },
    { "key": "noOverlaps", "type": "bool", "default": true, "group": "Placement", "basic": false,
      "doc": "Remove mushrooms whose cap or stem would cut into a larger one." },
    { "key": "gap", "type": "number", "unit": "m", "default": 0.003, "min": 0, "max": 1, "step": 0.001, "group": "Placement", "basic": false,
      "doc": "Least clearance kept between neighbouring mushrooms." },
    { "key": "clumping", "type": "number", "default": 0.75, "min": 0, "max": 1, "step": 0.05, "group": "Placement", "basic": true,
      "doc": "0 is an even carpet, 1 is tight separate clusters." },
    { "key": "clumpSize", "type": "number", "unit": "m", "default": 0.2, "min": 0.01, "max": 10, "step": 0.01, "group": "Placement", "basic": false,
      "doc": "Rough diameter of one cluster." },
    { "key": "maxSlope", "type": "number", "unit": "deg", "default": 75, "min": 0, "max": 90, "step": 1, "group": "Placement", "basic": true,
      "doc": "Steepest face the patch grows on; the editor filters the surface by it before sending it." },

    { "key": "height", "type": "number", "unit": "m", "default": 0.16, "min": 0.01, "max": 2, "step": 0.01, "group": "Form", "basic": true,
      "doc": "Stem height of the largest mushroom." },
    { "key": "sizeMin", "type": "number", "default": 0.3, "min": 0.01, "max": 1, "step": 0.05, "group": "Form", "basic": false,
      "doc": "Smallest mushroom, as a share of the largest." },
    { "key": "sizeMax", "type": "number", "default": 1, "min": 0.01, "max": 1, "step": 0.05, "group": "Form", "basic": false,
      "doc": "Largest mushroom, as a share of the height." },
    { "key": "maxTilt", "type": "number", "unit": "deg", "default": 15, "min": 0, "max": 80, "step": 1, "group": "Form", "basic": false,
      "doc": "Largest lean of a stem away from vertical." },
    { "key": "bend", "type": "number", "default": 0.7, "min": 0, "max": 1, "step": 0.05, "group": "Form", "basic": false,
      "doc": "How much leaning stems curve back upright toward the cap." },
    { "key": "capSize", "type": "number", "default": 1, "min": 0.1, "max": 3, "step": 0.05, "group": "Form", "basic": true,
      "doc": "Cap width multiplier." },
    { "key": "detail", "type": "number", "default": 0.3, "min": 0, "max": 1, "step": 0.05, "group": "Form", "basic": true,
      "doc": "Polygon budget: 0 is about 90 triangles a mushroom, 0.5 about 520, 1 about 1300." },

    { "key": "glow", "type": "number", "default": 2, "min": 0, "max": 20, "step": 0.1, "group": "Look", "basic": true,
      "doc": "Emission strength of the gills, exported as KHR_materials_emissive_strength." },
    { "key": "paleness", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.05, "group": "Look", "basic": false,
      "doc": "Lifts the cap and glow colours toward white." },
    { "key": "capVariants", "type": "int", "default": 8, "min": 1, "max": 8, "step": 1, "group": "Look", "basic": false,
      "doc": "Cap shades in use, from the first of the eight shade and stripe tables." },
    { "key": "stripeDarken", "type": "number", "default": 0.14, "min": 0, "max": 1, "step": 0.01, "group": "Look", "basic": false,
      "doc": "How much darker a cap stripe is at the rim, in OKLab lightness." },
    { "key": "capRoughness", "type": "number", "default": 0.15, "min": 0, "max": 1, "step": 0.01, "group": "Look", "basic": false,
      "doc": "Roughness of the cap tops." },
    { "key": "gillRoughness", "type": "number", "default": 0.6, "min": 0, "max": 1, "step": 0.01, "group": "Look", "basic": false,
      "doc": "Roughness of the gills." },
    { "key": "stemRoughness", "type": "number", "default": 0.55, "min": 0, "max": 1, "step": 0.01, "group": "Look", "basic": false,
      "doc": "Roughness of the stems above the dirt line." },
    { "key": "textureSize", "type": "enum", "options": [512, 1024], "default": 512, "unit": "px", "group": "Look", "basic": false,
      "doc": "Width of the albedo, emissive and ORM maps; they are twice as tall." },

    { "key": "maxTriangles", "type": "int", "default": 40000, "min": 1, "max": 200000, "step": 1000, "group": "Limits", "basic": false,
      "doc": "Most surface triangles the editor collects and the server accepts." },
    { "key": "maxEstimate", "type": "int", "default": 3000, "min": 1, "max": 20000, "step": 100, "group": "Limits", "basic": false,
      "doc": "Most mushrooms (area times density) a request may ask for; the overlap pass is exact and pairwise, so its cost grows with the square." }
  ]
}
