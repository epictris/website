{
  "kind": "boulder",
  "version": 1,
  "provisional": "Written by phase 3 so the generator has a schema to run against; phase 2's schema replaces it at merge. Keys and defaults are the plan's.",
  "groups": ["Shape", "Fracture", "Surface", "Material", "Bake"],
  "params": [
    { "key": "seed", "type": "int", "default": 31, "min": 0, "max": 2147483647, "step": 1, "group": "Shape", "basic": true,
      "doc": "Every random choice is drawn from it; the same outline and seed give the same rock." },
    { "key": "depth", "type": "number", "unit": "m", "default": 1.6, "min": 0.02, "max": 5, "step": 0.05, "group": "Shape", "basic": true,
      "doc": "The solid's depth through the gameplay plane, centred on it." },
    { "key": "tolerance", "type": "number", "unit": "m", "default": null, "min": 0.001, "max": 0.5, "step": 0.005, "group": "Shape", "basic": false,
      "doc": "How far the silhouette may stray from the outline; blank is min(0.04 m, 4 % of the square root of the outline's area)." },
    { "key": "edgeVariation", "type": "number", "default": 0.65, "min": 0, "max": 1, "step": 0.05, "group": "Shape", "basic": true,
      "doc": "How deeply the natural slabs' outline is chipped, as a share of the tolerance budget." },
    { "key": "weathering", "type": "number", "default": 0.38, "min": 0, "max": 1, "step": 0.05, "group": "Shape", "basic": true,
      "doc": "Corner bias and edge drift of the natural slabs." },
    { "key": "taperSlopeMin", "type": "number", "default": 0.32, "min": 0, "max": 2, "step": 0.01, "group": "Shape", "basic": false,
      "doc": "Least inward slope of a chunk's front or back, in metres of travel per metre of depth." },
    { "key": "taperSlopeMax", "type": "number", "default": 0.66, "min": 0, "max": 2, "step": 0.01, "group": "Shape", "basic": false,
      "doc": "Greatest inward slope of a chunk's front or back." },
    { "key": "taperReach", "type": "number", "default": 0.8, "min": 0.05, "max": 5, "step": 0.05, "group": "Shape", "basic": false,
      "doc": "How far in from the outline a chunk still tapers, times the depth." },
    { "key": "supportSlope", "type": "number", "default": 0.38, "min": 0, "max": 2, "step": 0.01, "group": "Shape", "basic": false,
      "doc": "Inward slope of the buried support that fills the seams." },
    { "key": "supportDepth", "type": "number", "default": 0.38, "min": 0.01, "max": 1, "step": 0.01, "group": "Shape", "basic": false,
      "doc": "Half-thickness of the buried support, times the depth." },

    { "key": "slabsPerArea", "type": "number", "unit": "1/m2", "default": 10, "min": 0.5, "max": 100, "step": 0.5, "group": "Fracture", "basic": true,
      "doc": "Natural slabs per square metre of outline, clamped to 2..100 slabs." },
    { "key": "chunkShare", "type": "number", "default": 0.65, "min": 0.05, "max": 3, "step": 0.05, "group": "Fracture", "basic": false,
      "doc": "Structural chunks per natural slab (at least 2)." },
    { "key": "chunkDepth", "type": "number", "default": 0.64, "min": 0.05, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Half-depth of the box the chunks are cut from, times the depth." },
    { "key": "chunkFlatten", "type": "number", "default": 0.73, "min": 0.1, "max": 1.5, "step": 0.01, "group": "Fracture", "basic": true,
      "doc": "Scale on the chunks' depth, so the natural slabs form the foremost faces." },
    { "key": "chunkShrinkMin", "type": "number", "default": 0.97, "min": 0.5, "max": 1, "step": 0.001, "group": "Fracture", "basic": false,
      "doc": "Least across-plane shrink of a chunk about its centre; the joint gaps." },
    { "key": "chunkShrinkMax", "type": "number", "default": 0.988, "min": 0.5, "max": 1, "step": 0.001, "group": "Fracture", "basic": false,
      "doc": "Greatest across-plane shrink of a chunk about its centre." },
    { "key": "chunkDepthScaleMin", "type": "number", "default": 0.95, "min": 0.1, "max": 3, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Least depth scale of a chunk's front and back faces." },
    { "key": "chunkDepthScaleMax", "type": "number", "default": 1.2, "min": 0.1, "max": 3, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Greatest depth scale of a chunk's front and back faces." },
    { "key": "chunkDepthShift", "type": "number", "default": 0.13, "min": 0, "max": 1, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Largest shift of a chunk through the plane, times the depth." },
    { "key": "chunkTilt", "type": "number", "default": 0.18, "min": 0, "max": 1, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Largest tilt of a chunk's front face, in metres of depth per metre across." },
    { "key": "chunkBevelMin", "type": "number", "unit": "m", "default": 0.027, "min": 0, "max": 0.3, "step": 0.001, "group": "Fracture", "basic": false,
      "doc": "Least bevel on a chunk's corners before the union." },
    { "key": "chunkBevelMax", "type": "number", "unit": "m", "default": 0.065, "min": 0, "max": 0.3, "step": 0.001, "group": "Fracture", "basic": false,
      "doc": "Greatest bevel on a chunk's corners before the union." },
    { "key": "slabProud", "type": "number", "default": 0.22, "min": 0, "max": 1, "step": 0.01, "group": "Fracture", "basic": true,
      "doc": "How far the natural slabs stand out of the chunk body, times the depth." },
    { "key": "slabWidthMin", "type": "number", "default": 0.29, "min": 0.01, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Least slab width, as a share of the outline's width." },
    { "key": "slabWidthMax", "type": "number", "default": 0.48, "min": 0.01, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Greatest slab width, as a share of the outline's width." },
    { "key": "slabThicknessMin", "type": "number", "default": 0.35, "min": 0.01, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Least slab thickness, as a share of the depth." },
    { "key": "slabThicknessMax", "type": "number", "default": 0.6, "min": 0.01, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Greatest slab thickness, as a share of the depth." },
    { "key": "slabLengthMin", "type": "number", "default": 0.19, "min": 0.01, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Least slab length, as a share of the outline's height." },
    { "key": "slabLengthMax", "type": "number", "default": 0.43, "min": 0.01, "max": 2, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Greatest slab length, as a share of the outline's height." },
    { "key": "slabYaw", "type": "number", "unit": "deg", "default": 28, "min": 0, "max": 90, "step": 1, "group": "Fracture", "basic": false,
      "doc": "Largest random turn of a slab about the view axis." },
    { "key": "fractureAngle", "type": "number", "unit": "deg", "default": 4, "min": -90, "max": 90, "step": 1, "group": "Fracture", "basic": false,
      "doc": "Turn added to every slab, so the grain leans one way." },
    { "key": "backSlabEvery", "type": "int", "default": 4, "min": 1, "max": 100, "step": 1, "group": "Fracture", "basic": false,
      "doc": "Every n-th slab sits on the back rather than the front." },
    { "key": "secondarySlabs", "type": "number", "default": 0, "min": 0, "max": 1, "step": 0.05, "group": "Fracture", "basic": false,
      "doc": "Chance a slab grows a thin secondary flake (skipped while the chunk edges are solid)." },
    { "key": "ridgeAmplitude", "type": "number", "default": 0.1, "min": 0, "max": 1, "step": 0.005, "group": "Fracture", "basic": false,
      "doc": "Broad ridge that moves slabs through the plane, times the depth." },
    { "key": "ridgeFine", "type": "number", "default": 0.045, "min": 0, "max": 1, "step": 0.005, "group": "Fracture", "basic": false,
      "doc": "Fine ridge over the broad one, times the depth." },
    { "key": "coreDepth", "type": "number", "default": 0.3, "min": 0, "max": 1, "step": 0.01, "group": "Fracture", "basic": false,
      "doc": "Depth of the core the slabs sit on at the outline's centre, times the depth." },

    { "key": "detail", "type": "number", "default": 1, "min": 0.25, "max": 4, "step": 0.25, "group": "Surface", "basic": true,
      "doc": "Voxel remesh resolution: the voxel is 30 % of the tolerance, divided by the square root of detail above 1." },
    { "key": "voxelCap", "type": "number", "unit": "m", "default": 0.012, "min": 0.002, "max": 0.1, "step": 0.001, "group": "Surface", "basic": false,
      "doc": "Largest voxel of the remesh that fuses the pieces." },
    { "key": "remeshAdaptivity", "type": "number", "default": 0.06, "min": 0, "max": 1, "step": 0.01, "group": "Surface", "basic": false,
      "doc": "How much the remesh merges faces on flat stretches." },
    { "key": "smoothFactor", "type": "number", "default": 0.65, "min": 0, "max": 2, "step": 0.05, "group": "Surface", "basic": false,
      "doc": "Strength of the smoothing that removes the voxel ridges." },
    { "key": "smoothIterations", "type": "int", "default": 2, "min": 0, "max": 30, "step": 1, "group": "Surface", "basic": false,
      "doc": "Passes of that smoothing." },
    { "key": "faceBudget", "type": "int", "default": 3000, "min": 200, "max": 100000, "step": 100, "group": "Surface", "basic": true,
      "doc": "Faces left by the decimation per 8.5 m of outline perimeter (never fewer than this), before the edge bevel." },
    { "key": "thinEdgeAngle", "type": "number", "unit": "deg", "default": 70, "min": 0, "max": 180, "step": 1, "group": "Surface", "basic": false,
      "doc": "A convex edge sharper than this, clear of the gameplay band, is rounded off." },
    { "key": "thinEdgeOffset", "type": "number", "unit": "m", "default": 0.045, "min": 0, "max": 0.5, "step": 0.001, "group": "Surface", "basic": false,
      "doc": "Width of that rounding." },
    { "key": "edgeBevelWidth", "type": "number", "unit": "m", "default": 0.018, "min": 0, "max": 0.2, "step": 0.001, "group": "Surface", "basic": true,
      "doc": "Width of the light-catching bevel on the finished rock's edges." },
    { "key": "edgeBevelAngle", "type": "number", "unit": "deg", "default": 36, "min": 0, "max": 180, "step": 1, "group": "Surface", "basic": false,
      "doc": "Edges sharper than this get the bevel." },
    { "key": "edgeBevelSegments", "type": "int", "default": 1, "min": 1, "max": 6, "step": 1, "group": "Surface", "basic": false,
      "doc": "Segments of that bevel." },
    { "key": "tipBand", "type": "number", "default": 0.015, "min": 0, "max": 0.2, "step": 0.001, "group": "Surface", "basic": false,
      "doc": "Band that finds a pointed chunk tip, times the depth (at most 0.022 m)." },
    { "key": "tipInset", "type": "number", "default": 0.09, "min": 0, "max": 0.5, "step": 0.005, "group": "Surface", "basic": false,
      "doc": "How much of a pointed tip is cut off, times the depth (at most 0.14 m)." },
    { "key": "sliverVolume", "type": "number", "default": 0.0006, "min": 0, "max": 0.05, "step": 0.0001, "group": "Surface", "basic": false,
      "doc": "A piece with less volume than this times the depth cubed is dropped." },
    { "key": "sliverThickness", "type": "number", "default": 0.028, "min": 0, "max": 0.5, "step": 0.001, "group": "Surface", "basic": false,
      "doc": "A piece thinner on average than this times the depth is dropped." },
    { "key": "backingDepth", "type": "number", "default": 0.105, "min": 0, "max": 1, "step": 0.005, "group": "Surface", "basic": false,
      "doc": "A shallow wedge is backed to this thickness, times the depth." },

    { "key": "color", "type": "color", "default": [0.13, 0.15, 0.18], "group": "Material", "basic": true,
      "doc": "The stone's base colour, linear RGB." },
    { "key": "roughness", "type": "number", "default": 0.86, "min": 0, "max": 1, "step": 0.01, "group": "Material", "basic": true,
      "doc": "Roughness of the exported material." },
    { "key": "variation", "type": "number", "default": 0.055, "min": 0, "max": 0.3, "step": 0.005, "group": "Material", "basic": false,
      "doc": "Brightness step between the five chunk shades." },
    { "key": "tintMin", "type": "number", "default": 0.84, "min": 0, "max": 2, "step": 0.01, "group": "Material", "basic": false,
      "doc": "Darkest a chunk shade may be, times the colour." },
    { "key": "tintMax", "type": "number", "default": 1.12, "min": 0, "max": 2, "step": 0.01, "group": "Material", "basic": false,
      "doc": "Brightest a chunk shade may be, times the colour." },
    { "key": "darkShade", "type": "number", "default": 0.78, "min": 0, "max": 2, "step": 0.01, "group": "Material", "basic": false,
      "doc": "The mineral clouds' dark end, times the shade." },
    { "key": "lightShade", "type": "number", "default": 1.25, "min": 0, "max": 3, "step": 0.01, "group": "Material", "basic": false,
      "doc": "The mineral clouds' light end, times the shade." },
    { "key": "rampLow", "type": "number", "default": 0.34, "min": 0, "max": 1, "step": 0.01, "group": "Material", "basic": false,
      "doc": "Noise value at which the clouds are darkest." },
    { "key": "rampMid", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "group": "Material", "basic": false,
      "doc": "Noise value at which the clouds are the plain shade." },
    { "key": "rampHigh", "type": "number", "default": 0.66, "min": 0, "max": 1, "step": 0.01, "group": "Material", "basic": false,
      "doc": "Noise value at which the clouds are lightest." },
    { "key": "noiseScale", "type": "number", "default": 1.25, "min": 0.01, "max": 50, "step": 0.05, "group": "Material", "basic": false,
      "doc": "Scale of the mineral clouds, per metre." },
    { "key": "grainScale", "type": "number", "default": 18, "min": 0.1, "max": 200, "step": 1, "group": "Material", "basic": false,
      "doc": "Scale of the fine grain in the baked normal, per metre." },
    { "key": "bumpStrength", "type": "number", "default": 0.085, "min": 0, "max": 1, "step": 0.005, "group": "Material", "basic": false,
      "doc": "Strength of that grain." },
    { "key": "wornEdgeLift", "type": "number", "default": 1.8, "min": 0, "max": 5, "step": 0.05, "group": "Material", "basic": false,
      "doc": "How much paler the worn bevels are than the stone." },
    { "key": "wornEdgeCap", "type": "number", "default": 0.38, "min": 0, "max": 1, "step": 0.01, "group": "Material", "basic": false,
      "doc": "Palest a worn bevel may be, per channel." },

    { "key": "bakeSize", "type": "enum", "options": [1024, 2048, 4096], "default": 2048, "unit": "px", "group": "Bake", "basic": false,
      "doc": "Width and height of the baked colour and normal maps." },
    { "key": "bakeSamples", "type": "int", "default": 8, "min": 1, "max": 256, "step": 1, "group": "Bake", "basic": false,
      "doc": "Cycles samples per bake." },
    { "key": "bakeMarginColor", "type": "int", "unit": "px", "default": 8, "min": 0, "max": 64, "step": 1, "group": "Bake", "basic": false,
      "doc": "Bleed around the colour map's islands." },
    { "key": "bakeMarginNormal", "type": "int", "unit": "px", "default": 12, "min": 0, "max": 64, "step": 1, "group": "Bake", "basic": false,
      "doc": "Bleed around the normal map's islands." },
    { "key": "uvAngle", "type": "number", "unit": "deg", "default": 60, "min": 1, "max": 89, "step": 1, "group": "Bake", "basic": false,
      "doc": "Smart UV project's angle limit." },
    { "key": "uvMargin", "type": "number", "default": 0.015, "min": 0, "max": 0.2, "step": 0.001, "group": "Bake", "basic": false,
      "doc": "Space between UV islands, as a share of the map." }
  ]
}
